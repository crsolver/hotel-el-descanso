---
import Icon from './Icon.astro';
import { hotels } from '../data/hotel';
import { ui } from '../data/ui';
import { localeFromPath } from '../lib/i18n';

const locale = localeFromPath(Astro.url.pathname);
const hotel = hotels[locale];
const copy = ui[locale];
const section = hotel.sections.location;

const mapSrc = `https://www.google.com/maps?q=${hotel.contact.coords.lat},${hotel.contact.coords.lng}&z=16&output=embed`;
const mapsLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(hotel.contact.mapsQuery)}`;
---

<section class="section" id="ubicacion">
  <div class="wrap">
    <div class="section-head">
      <div class="section-head__text">
        <p class="eyebrow">{section.eyebrow}</p>
        <h2>{section.title}</h2>
        <p>{section.text}</p>
      </div>
    </div>

    <div class="location">
      <div>
        <div class="location__address">
          <strong>{hotel.name}</strong>
          <span>{hotel.contact.address}</span>
          <span>{hotel.contact.city}</span>
        </div>

        <a class="btn btn--outline" href={mapsLink} target="_blank" rel="noopener noreferrer">
          <Icon name="pin" />
          {copy.cta.viewInMaps}
        </a>

        <div class="attractions">
          {
            hotel.attractions.map((attraction) => (
              <div class="attraction">
                <strong>{attraction.name}</strong>
                <span class="chip">{attraction.distance}</span>
                <p>{attraction.text}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="map-frame">
        <iframe
          src={mapSrc}
          title={`${copy.aria.map} ${hotel.name}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</section>
