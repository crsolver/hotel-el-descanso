const { name, class: className } = Astro.props;
const isFilled = filled.has(String(name));
---

<svg
  viewBox="0 0 24 24"
  fill={isFilled ? 'currentColor' : 'none'}
  stroke={isFilled ? 'none' : 'currentColor'}
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={icons[name as keyof typeof icons] ?? ''}
/>
