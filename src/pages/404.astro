---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { ui } from '../data/ui';

const copy = ui.es;
---

<Base title="Página no encontrada" description={copy.notFound.text} solidHeader noindex>
  <section class="not-found">
    <div>
      <p class="eyebrow" style="justify-content:center">{copy.notFound.eyebrow}</p>
      <h1>{copy.notFound.title}</h1>
      <p>{copy.notFound.text}</p>
      <div style="display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap">
        <a class="btn btn--primary" href="/">
          {copy.notFound.back}
          <Icon name="arrow-right" />
        </a>
        <a class="btn btn--outline" href="/#reservar">{copy.cta.checkAvailability}</a>
      </div>
    </div>
  </section>
</Base>
